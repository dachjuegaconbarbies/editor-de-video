{
  "name": "@autoeditor/server",
  "version": "0.1.0",
  "private": true,
  "description": "API REST + cola de trabajos + motor de edición (Claude) + render (ffmpeg/HyperFrames).",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/app.ts"
  },
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "start": "NODE_ENV=production tsx src/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "build": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@autoeditor/shared": "workspace:*",
    "@fastify/cors": "^11.3.0",
    "@fastify/multipart": "^10.1.2",
    "@fastify/static": "^10.1.5",
    "@fastify/swagger": "^9.9.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@hyperframes/producer": "^0.8.121",
    "archiver": "^8.0.0",
    "fast-json-patch": "^3.1.1",
    "fastify": "^5.12.5",
    "fastify-type-provider-zod": "^7.0.0",
    "gsap": "^3.15.0",
    "hyperframes": "^0.8.120",
    "mammoth": "^1.13.0",
    "nanoid": "^6.0.1",
    "unpdf": "^1.8.1",
    "yauzl": "^3.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/archiver": "^8.0.0",
    "@types/node": "^22.20.5",
    "@types/yauzl": "^3.4.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^5.0.3"
  }
}
