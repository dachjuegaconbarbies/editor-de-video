    "clsx": "^2.1.1",
    "elkjs": "^0.12.0",
    "lucide-react": "^1.52.0",
    "motion": "^14.0.0",
    "nanoid": "^6.0.1",
    "zundo": "^2.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^30.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "~5.9.3",
    "vitest": "^5.0.3"
