    "test": "vitest run",
    "build": "tsc --noEmit -p tsconfig.json"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@autoeditor/shared": "workspace:*",
