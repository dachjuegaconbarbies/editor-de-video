{
  "name": "@autoeditor/editor",
  "version": "0.1.0",
  "private": true,
  "description": "Componente React montable del autoeditor (lienzo de nodos + paneles). Se puede incrustar en otra app (Zyra).",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles.css"
  },
  "scripts": {
