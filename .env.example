# Copia este archivo a .env y llena lo que tengas. Nada de esto llega al navegador.
# Sin llaves la app funciona en MODO DEMO (editor determinista + IA simulada).

# Claude (editor). https://platform.claude.com/ → API keys
ANTHROPIC_API_KEY=

# Kie AI (imágenes, video, música, voz y efectos con IA). https://kie.ai
KIE_API_KEY=

# Servidor
PORT=4000
HOST=127.0.0.1
# Carpeta de datos (base de datos, archivos, renders). Relativa a la raíz del proyecto.
DATA_DIR=./data
# Tamaño máximo por archivo subido (MB)
MAX_UPLOAD_MB=4096
# Trabajos simultáneos (renders/análisis). 1–2 recomendado en laptops.
JOB_CONCURRENCY=1

# Herramientas externas (deja vacío para usar las del PATH)
FFMPEG_PATH=
FFPROBE_PATH=
# Python del worker de transcripción (lo crea `pnpm setup` en workers/python/.venv)
PYTHON_PATH=

# Transcripción vía API compatible con OpenAI (opcional, si no quieres usar faster-whisper local)
TRANSCRIPTION_API_KEY=

# Forzar modo demo aunque haya llaves (true/false)
DEMO_MODE=false

# Integración: header del que se toma el dueño (multiusuario) cuando se monta dentro de Zyra
OWNER_HEADER=x-owner-id
# Orígenes permitidos para CORS (separados por coma) cuando la interfaz vive en otro dominio
CORS_ORIGINS=http://localhost:5173
